---
const today = new Date();
import sunIcon from "pixelarticons/svg/sun.svg?raw";
import moonIcon from "pixelarticons/svg/moon.svg?raw";
---

<footer>
	<span>MIT &copy; {today.getFullYear()} <a href="https://github.com/julianZ99">/julianZ99</a></span>
	<button class="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch to light theme">
		<span class="icon-moon" set:html={moonIcon} />
		<span class="icon-sun" set:html={sunIcon} />
	</button>
</footer>