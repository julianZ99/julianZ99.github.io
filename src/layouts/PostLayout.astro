---
import { SITE_TITLE } from '../consts';
import BackgroundAnimation from '../components/BackgroundAnimation.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getLatestRelease } from '../lib/github';
import calendarIcon from 'pixelarticons/svg/calendar.svg?raw';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	githubRepo?: string;
	type?: string;
	heroImage?: any;
	lastCommitDate?: Date | null;
	hideTitle?: boolean;
}

const { title, description, pubDate, heroImage, lastCommitDate, githubRepo, type, hideTitle } = Astro.props;
const tabTitle = `${SITE_TITLE} - ${title}`;

const isProject = Boolean(githubRepo);
const badgeType = type ?? (isProject ? 'project' : 'blog');
const release = isProject ? await getLatestRelease(githubRepo) : null;
---

<html lang="en">
	<head>
		<BaseHead title={tabTitle} description={description} />

	</head>

	<body>
		<BackgroundAnimation />
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<Fragment>
							<div class="hero-image">
								<img width={1020} height={510} src={heroImage} alt="" />
							</div>
							<hr />
						</Fragment>
					)
				}
				<div class="content">
					<div class="title">
						<div class="title-row">
							{!hideTitle && <h1 data-typewriter>{title}</h1>}
							<div class="badges">
								<span class:list={['badge', `badge-${badgeType}`]}>{badgeType}</span>
								{release && <span class="badge badge-release">{release}</span>}
							</div>
						</div>
						<p class="description">{description}</p>
						<div class="meta">
							{
								githubRepo && (
									<a class="repo-link" href={`https://github.com/${githubRepo}`}>{githubRepo}</a>
								)
							}
							<div class="date">
								<div class="date-line">
									<span class="date-icon" set:html={calendarIcon} />
									<span>Published <FormattedDate date={pubDate} /></span>
								</div>
								{
									lastCommitDate && (
										<div>Last commit <FormattedDate date={lastCommitDate} /></div>
									)
								}
							</div>
						</div>
					</div>
				</div>
				<hr />
				<div class="content">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
