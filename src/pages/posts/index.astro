---
import { getCollection } from 'astro:content';
import BackgroundAnimation from '../../components/BackgroundAnimation.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getLatestRelease } from '../../lib/github';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const entries = await Promise.all(
	posts.map(async (post) => {
		const isProject = Boolean(post.data.githubRepo);
		const type = post.data.type ?? (isProject ? 'project' : 'blog');
		const release = isProject ? await getLatestRelease(post.data.githubRepo) : null;
		return { post, type, release };
	}),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} - Posts`} description={SITE_DESCRIPTION} />
		<script src="/scripts/size-entries.js" data-astro-rerun is:inline></script>
	</head>
	<body>
		<BackgroundAnimation />
		<Header />
		<main>
			<section>
				<ul>
					{
						entries.map(({ post, type, release }) => {
							const icon = post.data.icon;
							return (
								<li>
									<a href={`/posts/${post.id}/`} class:list={{ 'no-icon': !icon }}>
										{icon && (
											<img width={360} height={180} src={icon} alt="" onerror="this.style.display='none';this.parentElement.classList.add('no-icon')" />
										)}
										<div class="info">
											<div class="title-row">
												<h4 class="title">{post.data.title}</h4>
												<div class="badges">
													<span class:list={['badge', `badge-${type}`]}>{type}</span>
													{release && (
														<span class="badge badge-release">{release}</span>
													)}
												</div>
											</div>
											<p class="description">{post.data.description}</p>
											<div class="meta">
												{post.data.githubRepo && (
													<span class="repo-label">{post.data.githubRepo}</span>
												)}
												<div class="dates">
													<div class="date">
														Published <FormattedDate date={post.data.pubDate} />
													</div>
													{post.data.updatedDate && (
														<div class="date">
															Last commit <FormattedDate date={post.data.updatedDate} />
														</div>
													)}
												</div>
											</div>
										</div>
									</a>
								</li>
							);
						})
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
